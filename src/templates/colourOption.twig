{% set colours = option.color is defined ? option.color : option.colour %}
{% set isDefault = option.default %}
{% set active = null %}
{% set activeHandle = null %}
{% set fieldValue = fieldValue ?? null %}
{% set showLabel = showLabel ?? false %}
{% set hasDefaultOption = hasDefaultOption ?? false %}

{% if fieldValue|length %}
    {% if fieldValue.handle is defined and fieldValue.handle %}
        {% set activeHandle = fieldValue.handle %}
    {% else %}
        {% set active = fieldValue.label ?? null %}
    {% endif %}
{% endif %}

{# Generate handle for this option (same logic as PHP) #}
{% set optionHandle = option.handle ?? (option.label|camel) %}

{# Determine if this option should be marked as active #}
{% set isActive = false %}
{% if activeHandle %}
    {# Match by handle (preferred) #}
    {% set isActive = (optionHandle == activeHandle) %}
{% elseif active is not empty %}
    {# Fallback to label matching for backward compatibility #}
    {% set isActive = (option.label == active) %}
{% elseif isDefault and active is null and activeHandle is null and not hasDefaultOption %}
    {# No selection yet, use default - unless the field has its own "Default"
       choice, which is what an empty value means then #}
    {% set isActive = true %}
{% endif %}

{% if colours is iterable %}
    {# option.color is an array #}
    {% set value = {
        label: option.label,
        color: colours,
        handle: optionHandle,
    } %}
    {% set swatchStyle -%}
        {%- switch colours|length %}
            {% case 1 %}
                --color: {{ value.color[0].color is defined ? value.color[0].color : value.color[0].colour |parseRefs|raw }};
            {% default %}
                {% set percentage = 100 / colours|length %}
                --color: linear-gradient(to bottom right, {% for color in colours %}{{ color.color is defined ? color.color : color.colour |parseRefs|raw }} {{ percentage * loop.index0 }}%, {{ color.color is defined ? color.color : color.colour |parseRefs|raw }} {{ percentage * loop.index }}%{% if not loop.last %},{% endif %}{% endfor %});
        {% endswitch -%}
    {%- endset %}
{% else %}
    {# option.color is a string #}
    {% set value = {
        label: option.label,
        color: colours,
        handle: optionHandle,
    } %}
    {% if ';' in value.color %}
        {% set colours = value.color | split(';') %}
    {% else %}
        {% set colours = value.color | split(',') %}
    {% endif %}
    {% set swatchStyle -%}
        {%- switch colours | length %}
            {% case 1 %}
                --color: {{ value.color|parseRefs|raw }};
            {% default %}
                {% set percentage = 100 / colours | length %}
                --color: linear-gradient(to bottom right, {% for colour in colours %}{{ colour|parseRefs|raw }} {{ percentage * loop.index0 }}%, {{ colour|parseRefs|raw }} {{ percentage * loop.index }}%{% if not loop.last %},{% endif %}{% endfor %});
        {% endswitch -%}
    {%- endset %}
{% endif %}

<button type="button"
        class="option{{ isActive ? ' button-active' }}"
        data-value="{{ value|json_encode }}"
        aria-pressed="{{ isActive ? 'true' : 'false' }}"
        {% if not showLabel %}aria-label="{{ option.label }}" title="{{ option.label }}"{% endif %}>
    <span class="color-swatches__chip" style="{{ swatchStyle|trim }}" aria-hidden="true"></span>
    {% if showLabel %}<span class="color-swatches__label">{{ option.label }}</span>{% endif %}
</button>
