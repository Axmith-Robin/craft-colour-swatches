{% import "_includes/forms" as forms %}

{% set defaultValue = null %}
{% set options = field.useConfigFile
    ? palettes[field.palette] is defined
        ? palettes[field.palette]
        : field.palette == ''
            ? configOptions
            : []
    : field.options
%}

{% if options|length == 0 %}
    <p>{{ "The selected colour palette for this field isn\'t defined in the `colour-swatches.php` config file or settings."|t('colour-swatches') }}</p>
{% endif %}

{# Prepare field value - ensure handle is included if it exists #}
{% if fieldValue.color is defined %}
    {# fieldValue is already a model object with all properties #}
    {% set selected = fieldValue %}
    {% set fieldValueData = {
        label: fieldValue.label,
        color: fieldValue.color,
        class: fieldValue.class,
        default: fieldValue.default,
    } %}
    {# Include handle if it exists #}
    {% if fieldValue.handle is defined and fieldValue.handle %}
        {% set fieldValueData = fieldValueData|merge({handle: fieldValue.handle}) %}
    {% endif %}
    {% set fieldValueJson = fieldValueData|json_encode %}
{% else %}
    {% set selected = null %}
    {% set fieldValueJson = '' %}
{% endif %}

<div id="{{ id }}" class="color-swatches{{ field.showLabels ? ' color-swatches--labelled' }}" role="group" aria-label="{{ field.name }}">
    {# "Default" choice: saves no value, so the template's own default applies #}
    {% if field.showDefaultOption %}
        <button type="button"
                class="option option--default{{ selected is null ? ' button-active' }}"
                data-value=""
                aria-pressed="{{ selected is null ? 'true' : 'false' }}"
                {% if not field.showLabels %}aria-label="{{ (field.defaultOptionLabel ?: 'Default'|t('colour-swatches')) }}" title="{{ (field.defaultOptionLabel ?: 'Default'|t('colour-swatches')) }}"{% endif %}>
            <span class="color-swatches__chip" aria-hidden="true"></span>
            {% if field.showLabels %}<span class="color-swatches__label">{{ field.defaultOptionLabel ?: 'Default'|t('colour-swatches') }}</span>{% endif %}
        </button>
    {% endif %}

    {# fetch our color options #}
    {% for option in options %}
        {% include 'colour-swatches/colourOption' with {
            optionId: namespacedId ~ '-option-' ~ loop.index,
            option: option,
            fieldValue: selected,
            showLabel: field.showLabels,
            hasDefaultOption: field.showDefaultOption,
        } %}

        {# Set the default value with handle #}
        {% if option.default %}
            {% set optionHandle = option.handle ?? (option.label|camel) %}
            {% set value = {
                label: option.label,
                color: option.color is defined ? option.color : option.colour,
                handle: optionHandle,
            } %}
            {% set defaultValue = value|json_encode %}
        {% endif %}
    {% endfor %}
</div>

{# With a "Default" choice, an empty value is a real choice, not "use the
   configured default". #}
{% set fieldValueJson = fieldValueJson ?: (field.showDefaultOption ? '' : defaultValue) %}

{{ forms.hidden({
    id: id ~ namespacedId,
    name: name,
    value: fieldValueJson,
    class: 'color-swatches-input'})
}}
